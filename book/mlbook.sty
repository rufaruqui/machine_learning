  eigen-vec-tor eigen-val-ue nor-mal-i-za-tion op-ti-mi-za-tion
}

% ---------------- 16. exercises ----------------
\newcounter{sqctr}[chapter]
\newcounter{apctr}[chapter]
\newcounter{dpctr}[chapter]
\newcounter{pectr}[chapter]
\newcounter{qzctr}[chapter]

\newcommand{\sq}{\stepcounter{sqctr}%
  \par\vspace{4pt}\noindent\textbf{SQ\,\thechapter.\thesqctr.}\enspace}
\newcommand{\ap}{\stepcounter{apctr}%
  \par\vspace{6pt}\noindent\textbf{AP\,\thechapter.\theapctr.}\enspace}
\newcommand{\dpr}{\stepcounter{dpctr}%
  \par\vspace{6pt}\noindent\textbf{DP\,\thechapter.\thedpctr.}\enspace}
\newcommand{\pe}{\stepcounter{pectr}%
  \par\vspace{6pt}\noindent\textbf{PE\,\thechapter.\thepectr.}\enspace}
\newcommand{\qz}{\stepcounter{qzctr}%
  \par\vspace{4pt}\noindent\textbf{QZ\,\thechapter.\theqzctr.}\enspace}

\newcommand{\exercisesection}[1]{%
  \par\vspace{10pt}%
  \noindent{\sffamily\large\bfseries\color{MLBlue} #1}%
  \par\vspace{4pt}%
  \noindent{\color{MLBlue!25}\rule{\linewidth}{0.4pt}}%
  \par\vspace{4pt}%
}

% A chapter's closing reading paragraph. Two books, no more.
\newcommand{\furtherreading}{%
  \par\vspace{10pt}%
  \noindent{\sffamily\large\bfseries\color{MLBlue} Further Reading}%
  \par\vspace{4pt}%
  \noindent{\color{MLBlue!25}\rule{\linewidth}{0.4pt}}%
  \par\vspace{4pt}%
}

% Contour plot of a cost surface, drawn by pgfplots' gnuplot backend.
% #1 extra axis options, #2 comma-separated levels, #3 expression J(x,y).
\newcommand{\costcontour}[3]{%
  \addplot3[contour gnuplot={levels={#2},labels=false},
            samples=60, thick, #1] {#3};%
}

