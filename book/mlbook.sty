% ---------------------------------------------------------------
%  mlbook.sty --- shared style for the textbook
%    "Machine Learning: From Linear Models to Reinforcement Learning"
%
%  Loaded by main.tex.  All styling lives here; never style inside a
%  chapter file.
%
%  The colour palette and the maths shorthands are deliberately the same
%  as the companion lecture slides (see ../cse815/cse815.sty), so text and
%  figures move between the two without retyping.  If you change a macro
%  name in one file, change it in the other.
%
%  Compile: pdflatex -shell-escape -> biber -> makeindex -> pdflatex x2
%  -shell-escape is required: contour plots use pgfplots' gnuplot backend.
% ---------------------------------------------------------------
\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{mlbook}[2026/09/03 Machine Learning textbook style]

% ---------------- 1. encoding and fonts ----------------
\RequirePackage[T1]{fontenc}
\RequirePackage[utf8]{inputenc}
\RequirePackage{newpxtext}              % Palatino-style text
\RequirePackage{newpxmath}              % matching maths font
% Sans face for headings and box titles: TeX Gyre Heros (qhv), scaled to 94%
% of the text size, which is what newpxtext selects by default and the right
% optical match for Palatino.  Neither qhv nor the psnfss alternative phv ships
% with a basic TeX Live install; install both in user mode with
%   tlmgr --usermode --repository <2025 tlnet-final> install tex-gyre helvetic
% If they are unavailable, add \renewcommand*{\sfdefault}{lmss} below to fall
% back on Latin Modern Sans, which is always present.
\RequirePackage{inconsolata}            % monospace for code
\RequirePackage[expansion=false]{microtype}
\RequirePackage{setspace}
\setstretch{1.15}

% ---------------- 2. page geometry ----------------
\RequirePackage[
  b5paper,
  top=2.5cm, bottom=2.8cm,
  inner=2.8cm, outer=2.2cm,
  headsep=0.8cm, footskip=1.2cm
]{geometry}

% ---------------- 3. colour palette ----------------
\RequirePackage[dvipsnames,svgnames]{xcolor}
\definecolor{MLBlue}{HTML}{123B63}      % structure, definitions
\definecolor{MLTeal}{HTML}{1B7F79}      % key insights, worked examples
\definecolor{MLAmber}{HTML}{C97B17}     % derivations, algorithms
\definecolor{MLRose}{HTML}{9B2C4B}      % pitfalls
\definecolor{MLGray}{HTML}{4A5560}      % notes, folios
\definecolor{MLLight}{HTML}{EEF3F7}     % box background
\definecolor{MLLightAmber}{HTML}{FDF4E6}
\definecolor{MLLightRose}{HTML}{FBEEF2}
\definecolor{MLLightTeal}{HTML}{E8F4F3}
\definecolor{MLLightGray}{HTML}{F5F6F7}

% ---------------- 4. mathematics ----------------
\RequirePackage{amsmath}
\let\Bbbk\relax                         % newpxmath already defines it
\RequirePackage{amssymb}
\let\openbox\relax                      % ditto, before amsthm
\RequirePackage{amsthm}
\RequirePackage{bm}

% ---------------- 5. tables ----------------
\RequirePackage{booktabs}
\RequirePackage{tabularx}
\RequirePackage{longtable}
\RequirePackage{array}
\RequirePackage{multirow}
\newcolumntype{L}[1]{>{\raggedright\arraybackslash}p{#1}}
\newcolumntype{C}[1]{>{\centering\arraybackslash}p{#1}}
\newcolumntype{R}[1]{>{\raggedleft\arraybackslash}p{#1}}

% ---------------- 6. graphics, TikZ, pgfplots ----------------
\RequirePackage{graphicx}
\RequirePackage{tikz}
\usetikzlibrary{arrows.meta,positioning,calc,fit,backgrounds,matrix,
                shapes.geometric,shapes.misc,decorations.pathreplacing,patterns}
\RequirePackage{pgfplots}
\pgfplotsset{compat=1.17}
% House style for every axis in the book.
\pgfplotsset{
  mlaxis/.style={
    width=0.72\linewidth, height=5.4cm,
    grid=major, grid style={MLLight},
    tick label style={font=\scriptsize},
    label style={font=\small},
    title style={font=\small},
    legend style={font=\scriptsize, draw=none, fill=white, fill opacity=0.85,
                  text opacity=1},
  }
}
\RequirePackage{float}

% ---------------- 7. code listings ----------------
\RequirePackage{listings}
\renewcommand{\lstlistingname}{Listing}
\lstset{
  extendedchars=true, inputencoding=utf8,
  literate=
    {—}{{---}}{1}{–}{{--}}{1}{…}{{...}}{1}
    {α}{{$\alpha$}}{1}{λ}{{$\lambda$}}{1}{σ}{{$\sigma$}}{1}{μ}{{$\mu$}}{1}
}

\lstdefinestyle{pythonml}{
  language=Python,
  basicstyle=\ttfamily\footnotesize,
  backgroundcolor=\color{MLBlue!4},
  frame=single, framerule=0.5pt, rulecolor=\color{MLBlue!30},
  numbers=left, numberstyle=\tiny\color{MLGray}, numbersep=8pt,
  breaklines=true, showstringspaces=false,
  keywordstyle=\color{MLBlue}\bfseries,
  commentstyle=\color{MLTeal},   % no \itshape: inconsolata has no italic
  stringstyle=\color{MLRose},
  emphstyle=\color{MLAmber}\bfseries,
  emph={np,numpy,plt,array,dot,mean,shape,reshape},
  morekeywords={as,lambda,True,False,None,self,with,assert},
  captionpos=b, xleftmargin=14pt, xrightmargin=2pt,
  aboveskip=8pt, belowskip=4pt,
}

\lstdefinestyle{tfkeras}{
  style=pythonml,
  backgroundcolor=\color{MLAmber!6},
  rulecolor=\color{MLAmber!40},
  emph={Sequential,Dense,Input,model,compile,fit,predict,Adam,relu,sigmoid,softmax},
}

\lstdefinestyle{pseudocode}{
  basicstyle=\ttfamily\footnotesize,
  backgroundcolor=\color{MLGray!7},
  frame=single, framerule=0.5pt, rulecolor=\color{MLGray!40},
  numbers=left, numberstyle=\tiny\color{MLGray}, numbersep=8pt,
  breaklines=true, showstringspaces=false,
  captionpos=b, xleftmargin=14pt, aboveskip=8pt, belowskip=4pt,
}

\lstdefinestyle{shell}{
  basicstyle=\ttfamily\footnotesize\color{white},
  backgroundcolor=\color{black!88},
  frame=single, framerule=0.5pt, rulecolor=\color{black},
  numbers=none, breaklines=true, showstringspaces=false,
  captionpos=b, xleftmargin=14pt, aboveskip=8pt, belowskip=4pt,
}

% ---------------- 8. boxes ----------------
\RequirePackage[most,breakable]{tcolorbox}
\tcbuselibrary{skins,breakable,listings}

% Chapter-opening learning objectives.  No argument.
\newtcolorbox{chapterlearning}{
  enhanced, breakable,
  colback=MLBlue!5, colframe=MLBlue, colbacktitle=MLBlue, coltitle=white,
  fonttitle=\bfseries\normalsize\sffamily, title={Learning Objectives},
  left=8pt, right=8pt, top=6pt, bottom=8pt, arc=4pt, boxrule=1pt,
}

% Every other box takes one mandatory short title.
\newtcolorbox{defbox}[1]{
  enhanced, breakable,
  colback=white, colframe=MLBlue!55, colbacktitle=MLBlue!10, coltitle=MLBlue,
  fonttitle=\bfseries\small\sffamily,
  title={Definition\quad\textbar\quad #1},
  left=6pt, right=6pt, top=4pt, bottom=6pt, arc=4pt, boxrule=0.8pt,
}

\newtcolorbox{keyinsight}[1]{
  enhanced, breakable,
  colback=MLLightTeal, colframe=MLTeal, colbacktitle=MLTeal, coltitle=white,
  fonttitle=\bfseries\small\sffamily,
  title={Key Insight\quad\textbar\quad #1},
  left=6pt, right=6pt, top=4pt, bottom=6pt, arc=4pt, boxrule=0.8pt,
}

\newtcolorbox{pitfall}[1]{
  enhanced, breakable,
  colback=MLLightRose, colframe=MLRose, colbacktitle=MLRose, coltitle=white,
  fonttitle=\bfseries\small\sffamily,
  title={Pitfall\quad\textbar\quad #1},
  left=6pt, right=6pt, top=4pt, bottom=6pt, arc=4pt, boxrule=0.8pt,
}

\newtcolorbox{derivation}[1]{
  enhanced, breakable,
  colback=MLLightAmber, colframe=MLAmber, colbacktitle=MLAmber, coltitle=white,
  fonttitle=\bfseries\small\sffamily,
  title={Derivation\quad\textbar\quad #1},
  left=6pt, right=6pt, top=4pt, bottom=6pt, arc=4pt, boxrule=0.8pt,
}

\newtcolorbox{workedexample}[1]{
  enhanced, breakable,
  colback=MLLightTeal, colframe=MLTeal!75, colbacktitle=MLTeal!75, coltitle=white,
  fonttitle=\bfseries\small\sffamily,
  title={Worked Example\quad\textbar\quad #1},
  left=6pt, right=6pt, top=4pt, bottom=6pt, arc=4pt, boxrule=0.8pt,
}

\newtcolorbox{algorithmbox}[1]{
  enhanced, breakable,
  colback=MLLightAmber, colframe=MLAmber!80, colbacktitle=MLAmber!80, coltitle=white,
  fonttitle=\bfseries\small\sffamily,
  title={Algorithm\quad\textbar\quad #1},
  left=6pt, right=6pt, top=4pt, bottom=6pt, arc=4pt, boxrule=0.8pt,
}

\newtcolorbox{researchspotlight}[1]{
  enhanced, breakable,
  colback=MLLight, colframe=MLBlue, colbacktitle=MLBlue, coltitle=white,
  fonttitle=\bfseries\small\sffamily,
  title={Research Spotlight\quad\textbar\quad #1},
  left=6pt, right=6pt, top=4pt, bottom=6pt, arc=4pt, boxrule=0.8pt,
}

\newtcolorbox{labbox}[1]{
  enhanced, breakable,
  colback=MLLightGray, colframe=MLGray, colbacktitle=MLGray, coltitle=white,
  fonttitle=\bfseries\small\sffamily,
  title={In the Lab\quad\textbar\quad #1},
  left=6pt, right=6pt, top=4pt, bottom=6pt, arc=4pt, boxrule=0.8pt,
}

\newtcolorbox{ethicsnote}[1]{
  enhanced, breakable,
  colback=MLLightGray, colframe=MLGray!85, colbacktitle=MLGray!85, coltitle=white,
  fonttitle=\bfseries\small\sffamily,
  title={Ethics and Impact\quad\textbar\quad #1},
  left=6pt, right=6pt, top=4pt, bottom=6pt, arc=4pt, boxrule=0.8pt,
}

% ---------------- 9. headings ----------------
\RequirePackage{titlesec}
\titleformat{\chapter}[display]
  {\normalfont\sffamily}
  {\raggedleft\color{MLBlue!25}\fontsize{90}{90}\selectfont\thechapter}
  {-24pt}
  {\raggedright\color{MLBlue}\fontsize{22}{26}\selectfont\bfseries}
  [\vspace{4pt}\color{MLBlue}\rule{\linewidth}{1.8pt}\vspace{4pt}]
\titlespacing*{\chapter}{0pt}{-40pt}{28pt}

\titleformat{\section}
  {\normalfont\sffamily\Large\bfseries\color{MLBlue}}
  {\thesection}{0.9em}{}
  [\vspace{-4pt}\color{MLBlue!25}\rule{\linewidth}{0.5pt}]
\titleformat{\subsection}
  {\normalfont\sffamily\large\bfseries\color{MLBlue!85}}
  {\thesubsection}{0.9em}{}
\titleformat{\subsubsection}
  {\normalfont\sffamily\normalsize\bfseries\color{MLBlue!75}}
  {\thesubsubsection}{0.9em}{}

% ---------------- 10. headers and footers ----------------
\RequirePackage{fancyhdr}
\pagestyle{fancy}
\fancyhf{}
\renewcommand{\headrulewidth}{0.4pt}
\renewcommand{\footrulewidth}{0pt}
\fancyhead[LE]{\small\sffamily\color{MLGray}\nouppercase{\leftmark}}
\fancyhead[RO]{\small\sffamily\color{MLGray}\nouppercase{\rightmark}}
\fancyfoot[LE,RO]{\small\sffamily\color{MLGray}\thepage}
\fancypagestyle{plain}{%
  \fancyhf{}\renewcommand{\headrulewidth}{0pt}
  \fancyfoot[C]{\small\sffamily\color{MLGray}\thepage}}

% ---------------- 11. captions and lists ----------------
\RequirePackage{caption}
\RequirePackage{subcaption}
\captionsetup{font=small, labelfont={bf,color=MLBlue}, margin=10pt,
              justification=justified}
\RequirePackage{enumitem}
\setlist[itemize]{leftmargin=*, topsep=4pt, itemsep=2pt, parsep=0pt}
\setlist[enumerate]{leftmargin=*, topsep=4pt, itemsep=2pt, parsep=0pt}
\setlist[description]{leftmargin=0pt, topsep=4pt, itemsep=2pt}

\RequirePackage{epigraph}
\setlength{\epigraphwidth}{0.62\textwidth}
\renewcommand{\epigraphflush}{flushright}
\renewcommand{\epigraphrule}{0.4pt}

% ---------------- 12. bibliography ----------------
\RequirePackage[
  style=authoryear, backend=biber,
  maxcitenames=3, maxbibnames=99, giveninits=true,
  uniquename=init, dashed=false, isbn=false, doi=true, url=false, sorting=nyt
]{biblatex}

% ---------------- 13. cross-references, index ----------------
\RequirePackage[
  colorlinks=true, linkcolor=MLBlue, citecolor=MLTeal, urlcolor=MLAmber,
  bookmarksnumbered=true, bookmarksopen=true
]{hyperref}
\RequirePackage[capitalise,noabbrev,nameinlink]{cleveref}
% Chapters in the back matter must be referred to as appendices; main.tex
% issues \crefalias{chapter}{appendix} immediately after \appendix.
\crefname{appendix}{Appendix}{Appendices}
\Crefname{appendix}{Appendix}{Appendices}
\RequirePackage{makeidx}
\makeindex
\RequirePackage{emptypage}

% ---------------- 14. utility commands ----------------
\newcommand{\term}[1]{\textbf{\textit{#1}}\index{#1}}   % defined term
\newcommand{\tool}[1]{\textsf{#1}\index{#1}}            % software name
\newcommand{\code}[1]{\texttt{#1}}
\newcommand{\dataset}[1]{\texttt{#1}}

